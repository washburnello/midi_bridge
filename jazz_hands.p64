	apply = function(self, tab_ud, table_num)
		--Color table to poke into
		local _address = 0x8000 + table_num * 0x1000
		memmap(tab_ud, _address)
		
		--Apply to shapes
		poke(0x550b, 0x3f)
	end,
	----------------
	stash = function(self, tab_ud, num)
		self.table[num] = tab_ud
	end,
	----------------
