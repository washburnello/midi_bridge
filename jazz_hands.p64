--Configuration
local _X_position		= 1
local _Y_position		= 11
local _TOGGLE_key		= "f1"
local _FILL_color		= 1
local _OUTLINE_color = 7
local _SHADOW_color	= 1
local _TEXT_color		= 7
local _ACCENT1_color	= 24
local _ACCENT2_color	= 16
local _ACCENT3_color	= 27


