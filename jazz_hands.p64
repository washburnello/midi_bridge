--[[pod_format="raw",version="1.0.1",created="2024-04-17 13:28:56",notes="An Immediate Mode GUI Library",icon=userdata("u8",16,16,""),revision=12390,modified="2024-07-06 17:43:37",title="pgui",author="Sergio Rodriguez Gomez"]]
